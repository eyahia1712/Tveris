# --- AI (Claude) ------------------------------------------------------------
# Enables AI classification, vision for scanned PDFs, and layout mapping.
ANTHROPIC_API_KEY=
# TVERIS_MODEL=claude-opus-5
# TVERIS_AI=off            # force the rule engine only

# --- Data ---------------------------------------------------------------------
# Default: the bundled sample inbox in data/sample.
# TVERIS_DATA_DIR=/path/to/sample-bundle
# The organisers' Docker server: reads from it and enables self-evaluation.
# TVERIS_SOURCE_URL=http://localhost:8080

# --- Storage ------------------------------------------------------------------
# Postgres (Cloud SQL, Neon, Supabase...). Without it, runs are JSON files in .tveris/.
# DATABASE_URL=postgres://user:pass@host:5432/tveris

# --- Gmail --------------------------------------------------------------------
# OAuth client (Google Cloud console -> APIs & Services -> Credentials, "Web application").
# Authorised redirect URI: <TVERIS_PUBLIC_URL>/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string; encrypts the Gmail session cookie.
TVERIS_SECRET=
# Public URL of this deployment (used for the OAuth redirect).
# TVERIS_PUBLIC_URL=https://tveris-xxxx.a.run.app
# GMAIL_QUERY=newer_than:14d -in:chats -in:sent
# GMAIL_MAX_MESSAGES=150
